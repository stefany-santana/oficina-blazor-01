@page "/idade"
@rendermode InteractiveServer

<PageTitle>Idade</PageTitle>

<h1>Faixa etária</h1>

<input type="number" @bind="idade" @bind:event="oninput" />

<p>Faixa etária: @Classificar(idade)</p>
<p>Maior de idade? @EhMaiorDeIdade(idade)</p>

@code {
    int idade = 20;

    string Classificar(int anos)
    {
        if (anos < 12) { return "Criança"; }
        else if (anos < 18) { return "Adolescente"; }
        else if (anos < 60) { return "Adulto"; }
        else { return "Idoso"; }
    }

    bool EhMaiorDeIdade(int anos)
    {
        return anos >= 18;
    }
}
